diff --git a/wp-includes/pressgres-object-id.php b/wp-includes/pressgres-object-id.php
new file mode 100644
index 0000000000000000000000000000000000000000..19af2c38c9e7b836e5257f7da4818d4bf89cb7dd
--- /dev/null
+++ b/wp-includes/pressgres-object-id.php
@@ -0,0 +1,27 @@
+<?php
+/**
+ * Pressgres object ID helper.
+ *
+ * ILLUSTRATIVE DEMO PATCH ONLY (R-005 patch-mechanism spike). This is not the
+ * Pressgres UUID implementation; the real helper is designed under ADR-002/U-001.
+ *
+ * This file was added by Pressgres on 2026-11-22. It is part of a modified
+ * version of WordPress and is distributed under the GNU General Public License,
+ * version 2 or (at your option) any later version.
+ *
+ * @package Pressgres
+ */
+
+/**
+ * Normalizes an object ID without casting UUIDs to integers.
+ *
+ * @param mixed $id Candidate object ID.
+ * @return string|int Lower-case UUID string, or absint() of the input for legacy callers.
+ */
+function pressgres_object_id( $id ) {
+	if ( is_string( $id ) && 1 === preg_match( '/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i', $id ) ) {
+		return strtolower( $id );
+	}
+
+	return absint( $id );
+}
