{
    "name": "pressgres/pressgres",
    "description": "Pressgres monorepo",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": "^8.4",
        "pressgres/contracts": "^0.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true,
                "reference": "config",
                "versions": {
                    "pressgres/contracts": "0.1.0"
                }
            }
        }
    ],
    "config": {
        "platform": {
            "php": "8.4.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "cs": "phpcs"
    }
}
