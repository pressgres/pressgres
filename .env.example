# Copy to .env (git-ignored) and replace every change-me value before
# `docker compose up`. Generate values with e.g. `openssl rand -hex 24`.
# Compose refuses to start while a required value is unset.

COMPOSE_PROJECT_NAME=pressgres-dev

# PostgreSQL 18 bootstrap superuser (container admin only; never used by PHP).
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=change-me
PG_DATABASE=pressgres

# ADR-0011 roles, created by docker/postgres/initdb on first start of an empty volume.
# Changing these later has no effect until `docker compose down -v`.
WPS_MIGRATOR_PASSWORD=change-me
WPS_RUNTIME_PASSWORD=change-me

# Valkey object cache (ADR-0010).
VALKEY_PASSWORD=change-me

# Loopback-only host ports. Leave empty for an ephemeral port.
PG_HOST_PORT=55436
VALKEY_HOST_PORT=56380
MAILPIT_UI_PORT=58026
