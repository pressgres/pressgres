# Do not commit real secrets. Inject from deployment secret manager.
WPS_DB_HOST=postgres.internal.example
WPS_DB_NAME=pressgres
WPS_DB_USER=pressgres_runtime
WPS_DB_PASSWORD=<secret-reference>
WPS_PG_CA_FILE=/run/secrets/pg-ca.pem
WPS_REDIS_HOST=redis.internal.example
WPS_REDIS_PASSWORD=<secret-reference>
