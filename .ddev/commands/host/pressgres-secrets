#!/usr/bin/env bash
## Description: EXPERIMENTAL (untested): create gitignored Pressgres dev secrets for DDEV
## Usage: pressgres-secrets
## Example: "ddev pressgres-secrets"
# Writes random values into .ddev/.env.*.local (gitignored by DDEV >= v1.25.4)
# unless the files already exist. Run before the first `ddev start`.
#   .env.web.local             -> web container: runtime DB password, Valkey password
#   .env.valkey.local          -> valkey container: Valkey password
#   .env.pressgres-roles.local -> no container (no such service); read only by
#                                 `ddev pressgres-roles` and `ddev pressgres-smoke`
set -euo pipefail
cd "${DDEV_APPROOT:?run through ddev}/.ddev"

secret() { od -An -N24 -tx1 /dev/urandom | tr -d ' \n'; }

if [[ -e .env.pressgres-roles.local ]]; then
  echo "Secrets already exist; delete .ddev/.env.{web,valkey,pressgres-roles}.local to regenerate." >&2
  exit 0
fi

umask 077
runtime="$(secret)"
migrator="$(secret)"
valkey="$(secret)"
printf 'PG_RUNTIME_PASSWORD=%s\nVALKEY_PASSWORD=%s\n' "$runtime" "$valkey" > .env.web.local
printf 'VALKEY_PASSWORD=%s\n' "$valkey" > .env.valkey.local
printf 'WPS_RUNTIME_PASSWORD=%s\nWPS_MIGRATOR_PASSWORD=%s\n' "$runtime" "$migrator" > .env.pressgres-roles.local
echo "Wrote .ddev/.env.web.local, .env.valkey.local, .env.pressgres-roles.local"
